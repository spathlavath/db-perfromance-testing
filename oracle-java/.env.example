# Oracle Database Configuration
ORACLE_USER=your_username
ORACLE_PASSWORD=your_password
ORACLE_CONNECT_STRING=host:port/service_name

# Connection Pool Configuration
POOL_MIN=2
POOL_MAX=10
POOL_INCREMENT=1
POOL_TIMEOUT=60

# Application Configuration
PORT=3000
LOG_LEVEL=info

# ============================================================================
# Agent Selection - Choose which agents to enable
# ============================================================================
# Set to true/false to enable/disable agents
USE_OTEL=true
USE_NEW_RELIC=false

# ============================================================================
# New Relic Java APM Agent Configuration
# ============================================================================
# Uncomment and set USE_NEW_RELIC=true to enable New Relic APM
NEW_RELIC_LICENSE_KEY=your_new_relic_license_key
NEW_RELIC_APP_NAME=Oracle-HR-Portal-Java
NEW_RELIC_HOST=collector.newrelic.com
NEW_RELIC_LOG_LEVEL=info

# OpenTelemetry Configuration
OTEL_SERVICE_NAME=HR-Portal
OTEL_EXPORTER_OTLP_ENDPOINT=http://your-collector:4317
OTEL_EXPORTER_OTLP_HEADERS=api-key=your-api-key
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_COMPRESSION=gzip
OTEL_EXPORTER_OTLP_TIMEOUT=30000

# OpenTelemetry Attribute Limits
OTEL_ATTRIBUTE_VALUE_LENGTH_LIMIT=4095
OTEL_ATTRIBUTE_COUNT_LIMIT=128
OTEL_SPAN_ATTRIBUTE_COUNT_LIMIT=128
OTEL_SPAN_EVENT_COUNT_LIMIT=128
OTEL_SPAN_LINK_COUNT_LIMIT=128

# OpenTelemetry Exporters
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp

# OpenTelemetry Sampling
OTEL_TRACES_SAMPLER=always_on

# Batch Span Processor
OTEL_BSP_SCHEDULE_DELAY=5000
OTEL_BSP_MAX_QUEUE_SIZE=2048
OTEL_BSP_MAX_EXPORT_BATCH_SIZE=512
OTEL_BSP_EXPORT_TIMEOUT=30000

# Metrics Configuration
OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=delta
OTEL_EXPORTER_OTLP_METRICS_DEFAULT_HISTOGRAM_AGGREGATION=base2_exponential_bucket_histogram
OTEL_METRIC_EXPORT_INTERVAL=60000
OTEL_METRIC_EXPORT_TIMEOUT=30000

# Logs Batch Processor
OTEL_BLRP_SCHEDULE_DELAY=5000
OTEL_BLRP_MAX_QUEUE_SIZE=2048
OTEL_BLRP_MAX_EXPORT_BATCH_SIZE=512
OTEL_BLRP_EXPORT_TIMEOUT=30000

# Semantic Conventions
OTEL_SEMCONV_STABILITY_OPT_IN=http
OTEL_LOG_LEVEL=info

# K6 Configuration
K6_LOG_LEVEL=INFO
K6_DETAILED_LOGGING=false
K6_LOG_SLOW_REQUESTS_MS=5000
