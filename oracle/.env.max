# Environment Configuration for MAX Testing (2000 VUs)
# Use: docker-compose --env-file .env.max up

# Test Configuration
TEST_INTENSITY=max
TEST_DURATION=2400

# Connection Pool - Sized for 2000 VUs
POOL_MIN=600
POOL_MAX=2400
POOL_INCREMENT=100
POOL_TIMEOUT=30
QUEUE_TIMEOUT=60000

# Expected Resource Usage:
# - CPU: 80-100%
# - Memory: 4-8GB
# - Success Rate: >70% (finding breaking point)
# - Database sessions: Ensure Oracle can handle 2400+ sessions
