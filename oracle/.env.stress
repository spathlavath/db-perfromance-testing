# Stress Test Configuration - High Connection Pool
# Use with: docker-compose --env-file .env.stress up

# Database Connection Pool - Scaled for 1000 VUs
POOL_MIN=300
POOL_MAX=1200
POOL_INCREMENT=50
POOL_TIMEOUT=30
QUEUE_TIMEOUT=60000

# Test Configuration
TEST_INTENSITY=stress
PORT=3000
LOG_LEVEL=info

# Database Connection (Update these with your values)
ORACLE_USER=your_username
ORACLE_PASSWORD=your_password
ORACLE_CONNECT_STRING=your_connection_string

# OpenTelemetry Configuration
OTEL_SERVICE_NAME=HR-Portal-Stress-Test
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_COMPRESSION=gzip
