# Oracle Database Configuration (HR Schema)
ORACLE_USER=hr
ORACLE_PASSWORD=your_password_here
ORACLE_CONNECT_STRING=10.0.1.36:1521/pdb1.privatesubnet.oracledb.oraclevcn.com

# Connection Pool Settings
POOL_MIN=2
POOL_MAX=10
POOL_INCREMENT=1
POOL_TIMEOUT=60

# Application Settings
PORT=3000
AUTO_RUN=false

# Test Configuration
# Intensity options:
#   low    - 20 VUs, 3-5s think time, 30 min (baseline ~5-10 req/s)
#   medium - 50 VUs, 1-3s think time, 30 min (normal load ~20-30 req/s)
#   high   - 120 VUs, 0.5-2s think time, 30 min (peak load ~60-80 req/s)
#   stress - 50→400 VUs, 0.1-0.5s think time, 32 min (find breaking point ~200+ req/s)
#   max    - 100→500 VUs, NO think time, 13 min (crash test - overwhelms system ~500+ req/s)
TEST_INTENSITY=medium
TEST_DURATION=600

# Logging
LOG_LEVEL=info

# New Relic Configuration (Optional)
NEW_RELIC_LICENSE_KEY=your_newrelic_license_key_here
NEW_RELIC_APP_NAME=Oracle-HR-Portal

# K6 Load Testing Configuration
# Log levels: DEBUG, INFO, WARN, ERROR
K6_LOG_LEVEL=INFO

# Enable detailed response logging (true/false)
K6_DETAILED_LOGGING=false

# Log requests slower than this threshold (milliseconds)
K6_LOG_SLOW_REQUESTS_MS=5000
